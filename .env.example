# IndexNow key used by scripts/indexnow-submit.mjs and /indexnow-key.txt.
# Generate a 32+ character hexadecimal key and configure the same value in Vercel.
INDEXNOW_KEY=

# Optional override for local or preview submissions.
SITE_URL=https://www.sweezy.world

# Usage analytics: choose ONE production storage method.
# Persistent Node host: set an absolute path on a mounted persistent volume.
# An unset path uses .local/analytics for local development only.
SWEEZY_ANALYTICS_DIR=

# Serverless host: real HTTPS endpoint accepting JSON POSTs; never a public URL
# invented for this example. Configure retention (90 days) and private access.
# The sink takes precedence over SWEEZY_ANALYTICS_DIR when configured.
SWEEZY_ANALYTICS_SINK=
SWEEZY_ANALYTICS_TOKEN=
